# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: https://app.supabase.com → Project Settings → API

# Public anon key — safe to expose in the frontend
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ─── Edge Functions (server-side only — NEVER put in VITE_ vars) ──────────────
# Set these in Supabase Dashboard → Edge Functions → Secrets

# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key   ← in Supabase secrets, not here
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co ← auto-injected in Edge Functions

# ─── Stripe (for B2B billing, optional) ───────────────────────────────────────
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ─── Error monitoring (Sentry) ───────────────────────────────────────────────
# Use a SEPARATE Sentry project from the patient app — different privacy rules
# and noisier customer base. See src/lib/sentry.ts for the PHI scrubbing rules.
VITE_SENTRY_DSN=
