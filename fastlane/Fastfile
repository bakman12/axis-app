default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :release do
    # Authenticate with App Store Connect using an API key (no 2FA headaches)
    api_key = app_store_connect_api_key(
      key_id:        ENV["ASC_KEY_ID"],
      issuer_id:     ENV["ASC_ISSUER_ID"],
      key_content:   ENV["ASC_API_KEY_CONTENT"],
      in_house:      false,
    )

    # Stamp the build number with the CI run number so every upload is unique
    increment_build_number(
      xcodeproj:    "ios/App/App.xcodeproj",
      build_number: ENV["GITHUB_RUN_NUMBER"] || Time.now.to_i.to_s,
    )

    # Build the signed IPA
    build_app(
      workspace:        "ios/App/App.xcworkspace",
      scheme:           "App",
      configuration:    "Release",
      export_method:    "app-store",
      output_directory: "ios/build",
      output_name:      "Axis.ipa",
      export_xcargs:    "-allowProvisioningUpdates",
    )

    # Upload to TestFlight — reviewers can then promote to App Store
    upload_to_testflight(
      api_key:                          api_key,
      ipa:                              "ios/build/Axis.ipa",
      skip_waiting_for_build_processing: true,
      notify_external_testers:          false,
    )
  end
end
