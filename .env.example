# ─── Base44 (patient app backend) ────────────────────────────────────────────
VITE_BASE44_APP_ID=69845f8aa2ec587b032e775d

# ─── Axis Clinician Dashboard integration ────────────────────────────────────
# Get this from your Supabase project settings once you've deployed the
# clinician-dashboard. Leave empty to disable the "Share with Clinic" feature.
VITE_CLINIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# ─── Error monitoring (Sentry) ───────────────────────────────────────────────
# Create a project at sentry.io and paste the React DSN here.
# Leave empty in development to skip uploading errors. Production builds
# without this set will silently fall back to console.error.
# Privacy: see src/lib/sentry.js — breadcrumbs are disabled, no PII is sent.
VITE_SENTRY_DSN=
